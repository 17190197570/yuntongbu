<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CloudDrive Lite (Development)" Manufacturer="CloudDrive Lite" Version="$(var.ProductVersion)" Language="1033"
           UpgradeCode="FFBBF345-05E5-4FBB-90FA-6AB6E8FD23B5" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer CloudDrive Lite is installed. Use the documented recovery procedure; database downgrade is not automatic." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="OSBUILD"><RegistrySearch Id="BuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" /></Property>
    <Launch Condition="VersionNT64 AND OSBUILD &gt;= 19041" Message="Windows x64 build 19041 or later is required. Windows 11 is the primary validation target." />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="CloudDrive Lite" /></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CloudDriveMenu" Name="CloudDrive Lite">
        <Component Id="StartMenu" Guid="*">
          <Shortcut Id="Launch" Name="CloudDrive Lite" Target="[INSTALLFOLDER]CloudDrive.Bootstrap.exe" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\CloudDriveLite" Name="InstalledVersion" Value="$(var.ProductVersion)" Type="string" KeyPath="yes" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <CustomAction Id="CheckSafeRemoval" FileRef="$(var.AgentFileId)" ExeCommand="product-uninstall-check" Execute="immediate" Return="check" />
    <CustomAction Id="QuiesceUpgrade" FileRef="$(var.AgentFileId)" ExeCommand="product-upgrade-prepare" Execute="immediate" Return="check" />
    <CustomAction Id="FinishMaintenance" FileRef="$(var.AgentFileId)" ExeCommand="product-upgrade-finish" Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="QuiesceUpgrade" Before="InstallInitialize" Condition="WIX_UPGRADE_DETECTED OR (Installed AND NOT REMOVE)" />
      <Custom Action="CheckSafeRemoval" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="FinishMaintenance" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
    <Feature Id="Product" Title="CloudDrive Lite" Level="1"><ComponentGroupRef Id="Payload" /><ComponentRef Id="StartMenu" /></Feature>
  </Package>
</Wix>
